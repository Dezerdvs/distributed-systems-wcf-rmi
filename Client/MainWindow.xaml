<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="MainWindow" Height="273" Width="610">
    <Grid Margin="0,0,10,0" Height="263" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250*"/>
            <ColumnDefinition Width="187*"/>
        </Grid.ColumnDefinitions>
        <Button Content="Розрахувати" FontSize="22px" HorizontalAlignment="Left" Margin="91,136,0,0" VerticalAlignment="Top" Click="Button_Click" Grid.Column="1"/>
        <Label x:Name="RESULT" FontSize="22px" Content="-" HorizontalAlignment="Left" Margin="114,130,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="A" HorizontalAlignment="Left" Margin="27,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <TextBox x:Name="B" HorizontalAlignment="Left" Margin="164,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="C" HorizontalAlignment="Left" Margin="300,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Grid.ColumnSpan="2"/>
        <TextBox x:Name="X" HorizontalAlignment="Left" Margin="95,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Grid.Column="1" TextChanged="X_TextChanged"/>
        <Label x:Name="RESULT_Копировать" FontSize="22px" Content="Result" HorizontalAlignment="Left" Margin="40,130,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.029,0.281"/>
        <Label Content="A" HorizontalAlignment="Left" Margin="78,36,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.841,0.572"/>
        <Label Content="B" HorizontalAlignment="Left" Margin="215,36,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.841,0.572"/>
        <Label Content="C" HorizontalAlignment="Left" Margin="10,36,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.841,0.572" Grid.Column="1"/>
        <Label Content="X" HorizontalAlignment="Left" Margin="146,36,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.841,0.572" Grid.Column="1"/>

    </Grid>
</Window>
